{
    "name": "gammait",
    "version": "1.1.0",
    "description": "API Client for Gamma, the account system for the Software Engineering Student Division (IT)",
    "keywords": [
        "oauth2",
        "gamma",
        "chalmers"
    ],
    "homepage": "https://github.com/olillin/gammait#readme",
    "bugs": {
        "url": "https://github.com/olillin/gammait/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/olillin/gammait.git"
    },
    "license": "MIT",
    "author": "Oli <oli@olillin.com>",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "require": "./lib/index.js",
            "types": "./lib/index.d.ts"
        },
        "./urls": {
            "import": "./lib/urls.js",
            "require": "./lib/urls.js",
            "types": "./lib/urls.d.ts"
        }
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "/lib",
        "/src"
    ],
    "scripts": {
        "build": "rimraf lib && tsc",
        "format": "prettier . --write --list-different",
        "generate:jsdoc": "tsx scripts/generate-jsdoc.ts",
        "lint": "eslint",
        "test": "vitest"
    },
    "dependencies": {
        "simple-oauth2": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/compat": "^1.4.1",
        "@eslint/js": "^9.39.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^24",
        "@types/simple-oauth2": "^5.0.7",
        "eslint": "^9.39.1",
        "eslint-plugin-jsdoc": "^61.1.12",
        "prettier": "^3.6.2",
        "prettier-plugin-packagejson": "^3.0.2",
        "rimraf": "^6.0.1",
        "ts-morph": "^28.0.0",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.4",
        "vitest": "^4.0.8"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
